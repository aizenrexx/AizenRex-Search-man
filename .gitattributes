# Normalise line endings so the repository is identical on every machine.
* text=auto eol=lf

# Windows-native files that must keep CRLF
*.sln   text eol=crlf
*.csproj text eol=crlf
*.ps1   text eol=crlf

# Binaries - never diff or convert
*.ico   binary
*.png   binary
*.jpg   binary
*.gif   binary
*.zip   binary
*.exe   binary
*.dll   binary
*.pfx   binary

# Generated / vendored - keep them out of diffs and language stats
Distribution/Portable/*.xml linguist-generated=true
legacy_rust/Cargo.lock        linguist-vendored=true
